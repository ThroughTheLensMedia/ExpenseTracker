{
    "version": 2,
    "builds": [
        {
            "src": "api/server.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60
            }
        },
        {
            "src": "web-react/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/server.js"
        },
        {
            "source": "/(assets/.*|fonts/.*|.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.svg|.*\\.ico|.*\\.webp|.*\\.woff2|manifest\\.json|version\\.json|robots\\.txt|sitemap\\.xml)",
            "destination": "/web-react/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/web-react/index.html"
        }
    ],
    "crons": []
}